{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "V=$(cat .hugo-version) && curl -fsSL \"https://github.com/gohugoio/hugo/releases/download/v${V}/hugo_extended_${V}_linux-amd64.tar.gz\" | tar -xz hugo",
  "buildCommand": "./hugo --gc --minify -b \"https://${VERCEL_PROJECT_PRODUCTION_URL:-$VERCEL_URL}/\"",
  "outputDirectory": "public",
  "github": { "silent": true }
}
