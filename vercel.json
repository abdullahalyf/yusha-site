{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hugo",
  "buildCommand": "hugo --gc --minify",
  "outputDirectory": "public",
  "installCommand": "echo 'Hugo is provided by the build image'",
  "build": {
    "env": {
      "HUGO_VERSION": "0.170.1",
      "HUGO_ENVIRONMENT": "production"
    }
  },
  "github": {
    "silent": true
  }
}
